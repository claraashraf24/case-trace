APP_NAME=CaseTrace AI
APP_VERSION=0.1.0
ENVIRONMENT=development

POSTGRES_USER=casetrace_user
POSTGRES_PASSWORD=casetrace_password
POSTGRES_DB=casetrace_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://casetrace_user:casetrace_password@localhost:5432/casetrace_db
USE_LLM_EXTRACTION=true
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your_openai_api_key_here
USE_LLM_HYPOTHESES=true
USE_LLM_ASSISTANT=true